# Copy to backend/.env and fill in. Never commit .env.

# --- AI ---
GEMINI_API_KEY=
# "gemini" (real API) or "mock" (canned data, no key needed — for frontend development)
AI_MODE=gemini
GEMINI_MODEL=gemini-2.5-flash
# Used automatically when the primary model times out / is overloaded / rate limited. Empty disables.
GEMINI_FALLBACK_MODEL=gemini-2.5-flash-lite
GEMINI_THINKING_LEVEL=low
GEMINI_THINKING_BUDGET=0
GEMINI_TIMEOUT_SECONDS=45
GEMINI_MAX_RETRIES=2
GEMINI_MAX_CONCURRENCY=2
MAX_AI_REQUESTS_PER_DOCUMENT=12

# --- Limits ---
MAX_FILE_SIZE_MB=10
MAX_PAGES=50
DIRECT_TOKEN_THRESHOLD=15000
CHUNK_TARGET_TOKENS=4000
CHUNK_OVERLAP_TOKENS=200
MAX_CHUNKS=10
MAX_DOCUMENT_TOKENS=40000

# --- Gap analysis ---
MASTERY_STRONG_THRESHOLD=0.80
MASTERY_DEVELOPING_THRESHOLD=0.50
PRIORITY_DESCENDANT_WEIGHT=0.25

# --- Sessions / HTTP ---
SESSION_TTL_MINUTES=120
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
RATE_LIMIT_ANALYZE_PER_MINUTE=5
RATE_LIMIT_DEFAULT_PER_MINUTE=120
